{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.46.0",
        "maximumExclusive": "2.0.0"
    },
    "php": {
        "provider": "Pam\\Native\\Sensors\\SensorsPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.sensors",
        "minSdk": 26,
        "sourceDirs": [
            "android/src/main/kotlin"
        ]
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "CoreMotion"
        ]
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "sensors",
            "class": "dev.pam.sensors.SensorsModule",
            "iosClass": "SensorsModule"
        }
    ],
    "views": []
}
